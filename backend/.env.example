PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# SMTP Configuration (custom domain)
SMTP_HOST=smtp.yourdomain.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@yourdomain.com
SMTP_PASS=your_smtp_password
SMTP_FROM=Your App <your_email@yourdomain.com>
APP_NAME=ChatNotes
APP_TAGLINE=Secure Real-time Chat App
